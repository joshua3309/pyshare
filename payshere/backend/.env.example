# ─── PaySphere Backend Environment Variables ───────────────────────────────
# Copy to .env and fill in values. Each microservice reads from its own env.

# ─── Service Identity ─────────────────────────────────────────────────────
SERVICE_NAME=auth-service
SERVICE_VERSION=1.0.0

# ─── Server ───────────────────────────────────────────────────────────────
# Each service has its own port (overridden per service in docker-compose)
PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ─── Database (AWS RDS PostgreSQL) ────────────────────────────────────────
# Local dev:
DATABASE_URL="postgresql://paysphere:paysphere_dev@localhost:5432/paysphere?schema=public"
# AWS RDS (production):
# DATABASE_URL="postgresql://paysphere:PASSWORD@paysphere-db.xxx.us-east-1.rds.amazonaws.com:5432/paysphere?schema=public"
# With RDS Proxy:
# DATABASE_URL="postgresql://paysphere:PASSWORD@paysphere-db-proxy.proxy-xxx.us-east-1.rds.amazonaws.com:5432/paysphere?schema=public"

# ─── JWT Secrets (generate with: openssl rand -hex 32) ────────────────────
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_SERVICE_SECRET=your-service-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Service Discovery (inter-service communication) ─────────────────────
# In production (AWS): these point to the ALB internal listener or
# ECS service discovery endpoints.
# In development: localhost with per-service ports.
SERVICE_AUTH_URL=http://localhost:4001
SERVICE_USER_URL=http://localhost:4002
SERVICE_PAYMENT_URL=http://localhost:4003
SERVICE_TRANSACTION_URL=http://localhost:4004
SERVICE_WALLET_URL=http://localhost:4005
SERVICE_NOTIFICATION_URL=http://localhost:4006
SERVICE_BILLING_URL=http://localhost:4007

# ─── Stripe (optional — leave empty for mock mode) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (SMTP) — optional ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@paysphere.com

# ─── AWS (for production deployment) ──────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
ECS_CLUSTER_NAME=paysphere-cluster
ECR_REGISTRY=

# ─── Per-Service Port Overrides ──────────────────────────────────────────
# These override PORT when running a specific service
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
PAYMENT_SERVICE_PORT=4003
TRANSACTION_SERVICE_PORT=4004
WALLET_SERVICE_PORT=4005
NOTIFICATION_SERVICE_PORT=4006
BILLING_SERVICE_PORT=4007
